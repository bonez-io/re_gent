# re_gent self-hosted -- optional environment overrides for Docker Compose.
#
# Copy to .env (docker compose reads it automatically) or export these in
# your shell. Every variable here is optional; the defaults shown in comments
# apply when a variable is unset or empty.

# Initial password for the `admin` user, created on the server's first start
# against an empty data volume. When unset, the server generates a random
# 20-character password and prints it to its own stdout on first start (see
# `docker compose logs server`, or `regent-server` for the production
# profile). Either way, the wizard's first screen forces it to be replaced on
# first sign-in, so its exposure in a log is bounded to that window. Ignored
# once the data volume already has an admin user.
REGENT_ADMIN_PASSWORD=

# Host port the re_gent server (API) is published on. docker-compose.yml
# binds it to 127.0.0.1 only. Default: 7654.
REGENT_PORT=7654

# Host port the web UI is published on. docker-compose.yml binds it to
# 127.0.0.1 only. Default: 8080.
REGENT_WEB_PORT=8080

# Public DNS name of the server. Required by docker-compose.production.yml,
# where Caddy uses it to obtain an automatic TLS certificate; it also becomes
# the default "server address" the wizard records and prints in the connect
# command and in invitation links. Not used by docker-compose.yml.
REGENT_DOMAIN=

# Address printed in the first-start ready message and used in setup
# commands. Compose derives it from REGENT_WEB_PORT (local) or REGENT_DOMAIN
# (production); set it only when a proxy in front of Compose changes the origin.
# REGENT_PUBLIC_URL=https://regent.example.com
