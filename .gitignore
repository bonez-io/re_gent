# Build artifacts
/rgt
/dist/
/completions/
bin/
*.exe
*.dll
*.so
*.dylib

# Native local dev loop (make serve / make dev): server data, logs, pidfiles.
# Machine-local scratch space, never part of the repo.
.local/

# Regent-specific
# re_gent local state — machine-specific, like .git/ itself.
# config.toml is the exception: it is the server binding teammates inherit on clone.
# Excluding the directory itself would hide it, because git does not descend into
# an excluded directory to read the .gitignore that re-includes the binding.
.regent/*
!.regent/config.toml
!.regent/.gitignore
?*.regent

# Test artifacts
*.test
*.out
coverage.txt
*.prof

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Go
vendor/
go.work
go.work.sum

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp
*.log
*.pid
*.seed
*.pid.lock

# Terraform runtime state and local plans. Remote state lives in the dedicated
# versioned GCS bucket created by infra/gcp/provision.sh.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
terraform.tfvars

# Demo/dev artifacts
demo/.agents/
demo/.opencode/
demo/.codex/
plugins/
simple.py

# Scratch worktrees for parallel agent runs; never part of the repo.
.claude/worktrees/

# Machine-local agent setup generated while dogfooding this repository.
/.opencode/
/.pi/
/opencode.jsonc

# rgt writes these when it rewrites hook config; never commit them.
.claude/settings.json.bak-*
